# ──────────────────────────────────────────────────────────────────────
# Autonomous AI Agent - Environment Configuration
# ──────────────────────────────────────────────────────────────────────

# ── LLM Configuration ─────────────────────────────────────────────────
# Ollama/vLLM endpoint (OpenAI-compatible API)
# Model: HauhauCS Gemma4-12B Uncensored (Q4_K_M quantization from HuggingFace)
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=hf.co/HauhauCS/Gemma4-12B-QAT-Uncensored-HauhauCS-Balanced:Q4_K_M
LLM_API_KEY=ollama

# ── Backend Configuration ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Sandbox Configuration ─────────────────────────────────────────────
SANDBOX_IMAGE=ubuntu:22.04
SANDBOX_MEMORY=2g
SANDBOX_CPU=2.0
COMMAND_TIMEOUT=60

# ── Agent Configuration ───────────────────────────────────────────────
MAX_RETRIES=5
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=15

# ── Frontend Configuration ────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
