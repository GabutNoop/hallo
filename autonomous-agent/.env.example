# ──────────────────────────────────────────────────────────────────────
# Autonomous AI Agent - Environment Configuration
# ──────────────────────────────────────────────────────────────────────

# ── LLM (Ollama, OpenAI-compatible API) ───────────────────────────────
# Model: Dolphin 2.9 Llama 3 8B (Eric Hartford / Cognitive Computations)
#   dolphin-llama3:8b        -> 4.7GB, Q4_0, context default
#   dolphin-llama3:8b-256k   -> context 256k (butuh RAM >= 64GB)
#   dolphin-llama3:70b       -> butuh GPU/RAM besar
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=dolphin-llama3:8b
LLM_API_KEY=ollama
LLM_MAX_TOKENS=2048
# Set >0 untuk memaksa context window (mis. 256000 untuk varian 8b-256k)
LLM_NUM_CTX=0

# ── Backend ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*

# ── Sandbox (Docker, Ubuntu) ──────────────────────────────────────────
SANDBOX_IMAGE=ubuntu:22.04
SANDBOX_MEMORY=2g
SANDBOX_CPU=2.0
COMMAND_TIMEOUT=120

# ── Agent ─────────────────────────────────────────────────────────────
MAX_RETRIES=5
MAX_STEPS=25
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=20

# ── Frontend (dibaca saat build & runtime) ────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MODEL_NAME=dolphin-llama3:8b
